PORT=4174
NODE_ENV=development
MAX_BODY_BYTES=131072

# Production Telegram login requires a real Bot Token and BotFather /setdomain binding.
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=

# Production integrations.
PUBLIC_SITE_URL=https://your-domain.example
ALLOWED_ORIGINS=https://your-domain.example
TRON_GRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
ADMIN_SESSION_SECRET=
ADMIN_USERNAME=bitbernie
ADMIN_PASSWORD=
INTERNAL_API_SECRET=
INVENTORY_ENCRYPTION_KEY=

# 邮箱注册验证码：用 Resend HTTP API 发信（Cloudflare Workers 可用）。
# 留空时本地会降级把验证码打到控制台日志，便于联调。生产用 `wrangler secret put RESEND_API_KEY` 注入。
RESEND_API_KEY=
# 用户会话 token 签名密钥。留空则复用 ADMIN_SESSION_SECRET。
USER_SESSION_SECRET=
